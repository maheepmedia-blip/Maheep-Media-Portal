# GEMINI_API_KEY: Required for server-side Gemini AI News Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this portal is hosted (used for SEO canonicals & sitemaps).
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin passcode override for /admin login.
# If left empty, the first-run admin setup form in /admin allows claiming an account securely.
ADMIN_PASSCODE=

# ADMIN_EMAIL: Primary editorial administrator email address.
ADMIN_EMAIL="maheepmedia@gmail.com"

# Optional Supabase Configuration (if syncing or migrating to external Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional SMTP Email Configuration (for live admin contact notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Maheep News Portal <noreply@maheepnews.in>"
