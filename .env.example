# GEMINI_API_KEY: Required for server-side Gemini AI News Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this portal is hosted (used for SEO canonicals, robots.txt, sitemaps, and email confirmation links).
APP_URL="MY_APP_URL"

# DATA_DIR: Persistent directory for SQLite database, backups, and uploaded media (e.g. /var/data/maheep on Render).
DATA_DIR=

# DB_PATH: Optional explicit SQLite database file path (defaults to <DATA_DIR>/maheep.db).
DB_PATH=

# CRON_SECRET: Shared secret token required by /api/cron/:jobName endpoints when triggered externally.
CRON_SECRET=

# ADMIN_PASSCODE: Optional server-side admin passcode override for /admin login.
# If left empty, the first-run admin setup form in /admin allows claiming an account securely.
ADMIN_PASSCODE=

# ADMIN_EMAIL: Primary editorial administrator email address.
ADMIN_EMAIL="maheepmedia@gmail.com"

# Optional SMTP Email Configuration (for contact alerts, double opt-in confirmations, and digests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Maheep News Portal <noreply@maheepnews.in>"

# Optional Web Push VAPID keys (auto-generated and stored in DB if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:maheepmedia@gmail.com"

# Optional Supabase Configuration (if syncing or migrating to external Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
